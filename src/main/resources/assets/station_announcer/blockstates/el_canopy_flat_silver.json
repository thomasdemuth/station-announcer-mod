{
  "multipart": [
    {
      "when": {
        "axis": "x"
      },
      "apply": {
        "model": "station_announcer:block/el_canopy_flat_slab_silver"
      }
    },
    {
      "when": {
        "axis": "z"
      },
      "apply": {
        "model": "station_announcer:block/el_canopy_flat_slab_silver",
        "y": 90
      }
    },
    {
      "when": {
        "north": "false"
      },
      "apply": {
        "model": "station_announcer:block/el_canopy_fascia_silver"
      }
    },
    {
      "when": {
        "east": "false"
      },
      "apply": {
        "model": "station_announcer:block/el_canopy_fascia_silver",
        "y": 90
      }
    },
    {
      "when": {
        "south": "false"
      },
      "apply": {
        "model": "station_announcer:block/el_canopy_fascia_silver",
        "y": 180
      }
    },
    {
      "when": {
        "west": "false"
      },
      "apply": {
        "model": "station_announcer:block/el_canopy_fascia_silver",
        "y": 270
      }
    }
  ]
}
