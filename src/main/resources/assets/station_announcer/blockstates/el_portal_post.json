{
  "multipart": [
    {
      "apply": {
        "model": "station_announcer:block/el_portal_post_shaft"
      }
    },
    {
      "when": {
        "facing": "north",
        "up": "false"
      },
      "apply": {
        "model": "station_announcer:block/el_portal_post_bracket"
      }
    },
    {
      "when": {
        "facing": "east",
        "up": "false"
      },
      "apply": {
        "model": "station_announcer:block/el_portal_post_bracket",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "up": "false"
      },
      "apply": {
        "model": "station_announcer:block/el_portal_post_bracket",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "up": "false"
      },
      "apply": {
        "model": "station_announcer:block/el_portal_post_bracket",
        "y": 270
      }
    }
  ]
}
