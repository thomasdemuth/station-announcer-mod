{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "station_announcer:block/zebra_board_hanging_beam"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "station_announcer:block/zebra_board_hanging_beam",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "station_announcer:block/zebra_board_hanging_beam",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "station_announcer:block/zebra_board_hanging_beam",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "north",
        "left": "false"
      },
      "apply": {
        "model": "station_announcer:block/zebra_board_hanging_cap_left"
      }
    },
    {
      "when": {
        "facing": "east",
        "left": "false"
      },
      "apply": {
        "model": "station_announcer:block/zebra_board_hanging_cap_left",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "left": "false"
      },
      "apply": {
        "model": "station_announcer:block/zebra_board_hanging_cap_left",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "left": "false"
      },
      "apply": {
        "model": "station_announcer:block/zebra_board_hanging_cap_left",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "north",
        "right": "false"
      },
      "apply": {
        "model": "station_announcer:block/zebra_board_hanging_cap_right"
      }
    },
    {
      "when": {
        "facing": "east",
        "right": "false"
      },
      "apply": {
        "model": "station_announcer:block/zebra_board_hanging_cap_right",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "right": "false"
      },
      "apply": {
        "model": "station_announcer:block/zebra_board_hanging_cap_right",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "right": "false"
      },
      "apply": {
        "model": "station_announcer:block/zebra_board_hanging_cap_right",
        "y": 270
      }
    },
    {
      "when": {
        "OR": [
          {
            "left": "false"
          },
          {
            "right": "false"
          }
        ]
      },
      "apply": {
        "model": "station_announcer:block/zebra_board_hanging_pole"
      }
    }
  ]
}
