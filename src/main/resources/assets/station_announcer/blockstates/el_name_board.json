{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "station_announcer:block/el_name_board_model"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "station_announcer:block/el_name_board_model",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "station_announcer:block/el_name_board_model",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "station_announcer:block/el_name_board_model",
        "y": 270
      }
    }
  ]
}
