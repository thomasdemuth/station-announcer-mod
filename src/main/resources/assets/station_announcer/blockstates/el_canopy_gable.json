{
  "multipart": [
    {
      "when": {
        "axis": "x"
      },
      "apply": {
        "model": "station_announcer:block/el_canopy_gable_roof"
      }
    },
    {
      "when": {
        "axis": "z"
      },
      "apply": {
        "model": "station_announcer:block/el_canopy_gable_roof",
        "y": 90
      }
    },
    {
      "when": {
        "axis": "x",
        "west": "false"
      },
      "apply": {
        "model": "station_announcer:block/el_canopy_gable_end"
      }
    },
    {
      "when": {
        "axis": "x",
        "east": "false"
      },
      "apply": {
        "model": "station_announcer:block/el_canopy_gable_end",
        "y": 180
      }
    },
    {
      "when": {
        "axis": "z",
        "north": "false"
      },
      "apply": {
        "model": "station_announcer:block/el_canopy_gable_end",
        "y": 90
      }
    },
    {
      "when": {
        "axis": "z",
        "south": "false"
      },
      "apply": {
        "model": "station_announcer:block/el_canopy_gable_end",
        "y": 270
      }
    }
  ]
}
