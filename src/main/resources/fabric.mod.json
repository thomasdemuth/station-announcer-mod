{
  "schemaVersion": 1,
  "id": "station_announcer",
  "version": "${version}",
  "name": "Station Announcer",
  "description": "A station add-on for Minecraft Transit Railway: spoken PA announcements, NYC and railroad PIDS, MTA signs, working fare gates, station building blocks, gap fillers, builder tools, operations tools and a web dispatch map.",
  "authors": [
    "Thomas Demuth"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/station-announcer",
    "sources": "https://github.com/thomasdemuth/station-announcer-mod",
    "issues": "https://github.com/thomasdemuth/station-announcer-mod/issues"
  },
  "license": "MIT",
  "icon": "assets/station_announcer/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.stationannouncer.StationAnnouncer"
    ],
    "client": [
      "com.stationannouncer.client.StationAnnouncerClient"
    ],
    "modmenu": [
      "com.stationannouncer.client.modmenu.ModMenuIntegration"
    ]
  },
  "mixins": [
    "station_announcer.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
    "minecraft": "~1.20.4",
    "java": ">=17",
    "mtr": ">=4.0.0"
  }
}